# RoadGuardian — Environment Configuration Template
# Copy this file to .env and set your local credentials.

# PostgreSQL Connection String
# Format: postgresql://username:password@localhost:5432/roadguardian
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/roadguardian

# Storage Backend (LOCAL / S3 / MINIO)
STORAGE_BACKEND=LOCAL

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
